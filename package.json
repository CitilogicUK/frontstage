{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.15.0 || ^26.13.0"
  },
  "scripts": {
    "start": "backstage-cli repo start --config ../../app-config.yaml --config ../../app-config.development.yaml",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:audit": "node --test scripts/verify-audit.test.mjs",
    "test:starters": "node --test \"packages/app/public/starters/**/*.test.mjs\"",
    "verify:code": "backstage-cli config:check --config app-config.yaml --config app-config.development.yaml --config app-config.reviewer.yaml && yarn tsc --noEmit && yarn lint:all && yarn test --watch=false --runInBand && yarn test:starters && yarn test:audit",
    "verify": "yarn verify:code && yarn build:all && yarn test:e2e",
    "demo:seed": "node scripts/seed-gateway-demo.mjs",
    "audit:verify": "node scripts/verify-audit.mjs"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.8",
    "@backstage/cli-defaults": "^0.1.8",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "^30.5.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "fflate": "^0.8.2",
    "jest": "^30.5.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^13.1.0",
    "prettier": "^2.3.2",
    "typescript": "~5.9.0"
  },
  "resolutions": {
    "@backstage/backend-openapi-utils/mockttp": "4.6.5",
    "@octokit/plugin-paginate-rest": "9.2.2",
    "@octokit/request": "8.4.1",
    "@octokit/request-error": "5.1.1",
    "@octokit/rest": "20.0.2",
    "@yarnpkg/core": "4.9.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "get-uri/basic-ftp": "6.2.6",
    "minimatch@npm:^9.0.4": "11.0.9",
    "minimatch@npm:^9.0.9": "11.0.9",
    "minimatch@npm:^10.2.2": "11.0.9",
    "refractor@npm:3.6.0/prismjs": "1.30.0",
    "uuid@npm:^3.4.0": "11.1.1",
    "uuid@npm:^8.3.2": "11.1.1",
    "uuid@npm:^9.0.0": "11.1.1",
    "uuid@npm:^9.0.1": "11.1.1",
    "uuid@npm:^10.0.0": "11.1.1",
    "@material-table/core@npm:^3.1.0": "patch:@material-table/core@npm%3A3.2.5#~/.yarn/patches/@material-table-core-npm-3.2.5-5a76f950c0.patch"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
