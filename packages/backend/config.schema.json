{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "governance": {
      "type": "object",
      "properties": {
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Backstage user entity references authorized to review critical apps and import inventories."
        },
        "tierPolicy": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional minimum tiers. Built-in policy floors remain in effect.",
          "properties": {
            "audience": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "personal": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "team": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "company": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "external": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                }
              }
            },
            "classification": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "internal": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "confidential": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "restricted": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                }
              }
            },
            "hostedSharing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "private": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "named people": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "company": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "public link": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                }
              }
            },
            "connection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "read": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "write": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                }
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "description": "Prototype gateway policy and provider configuration.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": ["simulation", "openai"]
            },
            "openaiApiKey": {
              "type": "string",
              "visibility": "secret",
              "minLength": 1
            },
            "models": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allowedClassifications"],
                "properties": {
                  "allowedClassifications": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "public",
                        "internal",
                        "confidential",
                        "restricted"
                      ]
                    }
                  },
                  "maxCompletionTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "inputUsdPerMillionTokens": {
                    "type": "number",
                    "minimum": 0
                  },
                  "outputUsdPerMillionTokens": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "appSpendThresholds": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sourceUrl", "monthlyUsd"],
                "additionalProperties": false,
                "properties": {
                  "sourceUrl": { "type": "string" },
                  "stopAtThreshold": { "type": "boolean" },
                  "monthlyUsd": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            },
            "appRateLimits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sourceUrl", "requestsPerMinute"],
                "additionalProperties": false,
                "properties": {
                  "sourceUrl": { "type": "string" },
                  "requestsPerMinute": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                }
              }
            },
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "discovery": {
          "type": "object",
          "properties": {
            "github": {
              "type": "object",
              "required": ["organization", "topic"],
              "properties": {
                "organization": {
                  "type": "string"
                },
                "topic": {
                  "type": "string"
                },
                "token": {
                  "type": "string",
                  "visibility": "secret"
                },
                "scanIntervalMinutes": {
                  "type": "integer",
                  "minimum": 15,
                  "maximum": 10080
                }
              }
            }
          }
        },
        "reviewTracks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["security", "dataProtection"],
          "properties": {
            "security": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "dataProtection": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
