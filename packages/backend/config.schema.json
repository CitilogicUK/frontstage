{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "governance": {
      "type": "object",
      "properties": {
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Backstage user entity references authorized to review critical apps and import inventories."
        },
        "requireHumanApprovalEvidence": {
          "type": "boolean",
          "default": false,
          "description": "Require reviewer verification and an HTTPS evidence link when approving a Tier 3 app that takes actions."
        },
        "firstDecisionTargetWeekdays": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional target in UTC weekdays for the first overall Tier 3 review decision."
        },
        "retirementReviewIntervalMinutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 10080,
          "description": "Interval for opening owner retirement reviews based on recorded live gateway activity. Unset disables scheduling."
        },
        "reviewReminderIntervalMinutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 10080,
          "description": "Interval in minutes for sending owner inbox reminders for scheduled review renewals and hosted workspace confirmations. Unset disables reminders."
        },
        "reviewManagerEscalationDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Optional number of overdue calendar days before escalating a Tier 2 or Tier 3 renewal to the owner's active Catalog manager after an owner reminder."
        },
        "reviewGatewayPauseDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Optional overdue calendar days before pausing Tier 2 gateway requests after manager notification. Requires scheduled owner reminders and manager escalation."
        },
        "graduationGroups": {
          "type": "array",
          "description": "Active catalog Group entity references allowed to receive Tier 3 ownership transfers. An empty or unset list disables graduation.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^group:[a-z0-9_.-]+/[a-z0-9_.-]+$"
          }
        },
        "approvedHostedWorkspaces": {
          "type": "array",
          "description": "Approved provider and workspace pairs and optional sharing and data access restrictions.",
          "items": {
            "type": "object",
            "required": ["provider", "workspace"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "workspace": { "type": "string", "minLength": 1 },
              "allowedSharing": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": ["private", "named people", "company", "public link"]
                },
                "description": "Permitted sharing settings. Unset allows any sharing setting."
              },
              "allowedDataAccess": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "none",
                    "stores input",
                    "reads connected data",
                    "both"
                  ]
                },
                "description": "Permitted data access settings. Unset allows any data access setting."
              }
            }
          }
        },
        "approvedConnectors": {
          "type": "array",
          "description": "Read-only guidance for approved MCP servers and data connectors. Does not configure runtime connections.",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "description",
              "access",
              "maxClassification"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "kind": { "type": "string", "enum": ["mcp", "data"] },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "access": { "type": "string", "enum": ["read", "write"] },
              "maxClassification": {
                "type": "string",
                "enum": ["public", "internal", "confidential", "restricted"]
              },
              "docsUrl": {
                "type": "string",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s\\\\]+(?:[/?#][^\\s\\\\]*)?$"
              }
            }
          }
        },
        "tierPolicy": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional minimum tiers. Built-in policy floors remain in effect.",
          "properties": {
            "audience": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "personal": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "team": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "company": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "external": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                }
              }
            },
            "classification": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "internal": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "confidential": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "restricted": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                }
              }
            },
            "hostedSharing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "private": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "named people": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "company": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "public link": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                }
              }
            },
            "connection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "read": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                },
                "write": {
                  "type": "integer",
                  "enum": [1, 2, 3]
                }
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "description": "Prototype gateway policy and provider configuration.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": ["simulation", "openai"]
            },
            "openaiApiKey": {
              "type": "string",
              "visibility": "secret",
              "minLength": 1
            },
            "models": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allowedClassifications"],
                "properties": {
                  "allowedClassifications": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "public",
                        "internal",
                        "confidential",
                        "restricted"
                      ]
                    }
                  },
                  "maxCompletionTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "inputUsdPerMillionTokens": {
                    "type": "number",
                    "minimum": 0
                  },
                  "outputUsdPerMillionTokens": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "appSpendThresholds": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sourceUrl", "monthlyUsd"],
                "additionalProperties": false,
                "properties": {
                  "sourceUrl": { "type": "string" },
                  "stopAtThreshold": { "type": "boolean" },
                  "monthlyUsd": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            },
            "appRateLimits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sourceUrl", "requestsPerMinute"],
                "additionalProperties": false,
                "properties": {
                  "sourceUrl": { "type": "string" },
                  "requestsPerMinute": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                }
              }
            },
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "discovery": {
          "type": "object",
          "properties": {
            "github": {
              "type": "object",
              "required": ["organization", "topic"],
              "properties": {
                "organization": {
                  "type": "string"
                },
                "topic": {
                  "type": "string"
                },
                "token": {
                  "type": "string",
                  "visibility": "secret"
                },
                "scanIntervalMinutes": {
                  "type": "integer",
                  "minimum": 15,
                  "maximum": 10080
                }
              }
            }
          }
        },
        "reviewTracks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["security", "dataProtection"],
          "properties": {
            "security": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "dataProtection": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
