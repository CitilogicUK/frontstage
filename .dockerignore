# Only pass the build inputs used by the packaged pilot backend.
*
!.dockerignore
!backstage.json
!package.json
!yarn.lock
!.yarnrc.yml
!.yarn/
.yarn/*
!.yarn/patches/

!app-config.yaml
!app-config.postgres.yaml
!app-config.github-signin.yaml

!packages/
packages/*
!packages/backend/
packages/backend/*
!packages/backend/Dockerfile
!packages/backend/dist/
packages/backend/dist/*
!packages/backend/dist/skeleton.tar.gz
!packages/backend/dist/bundle.tar.gz
